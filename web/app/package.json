{
  "name": "detonger-web-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm:build": "wasm-pack build ../../crates/detonger-wasm --target web --out-dir ../../web/app/src/wasm/pkg --out-name detonger_wasm --release",
    "predev": "bun run wasm:build",
    "dev": "vite",
    "prebuild": "bun run wasm:build",
    "build": "tsc -b && vite build",
    "prelint": "bun run wasm:build",
    "lint": "eslint . && tsc -b --pretty false",
    "pretest": "bun run wasm:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:smoke": "bun run wasm:build",
    "test:smoke": "playwright test --config ./playwright.config.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.8",
    "@vitest/ui": "^4.0.8",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.57.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.8"
  }
}
